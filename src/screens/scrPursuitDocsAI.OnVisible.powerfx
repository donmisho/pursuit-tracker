// Paste into: Power Apps Studio -> Tree view -> scrPursuitDocsAI -> OnVisible property
//

Set(gblPursuit, LookUp('pursuit-tracker-pursuits', Title = gblPursuitKey));

// Stamp the pursuit onto anything uploaded to its folder. Nothing in the app creates a
// library item -- Add Document hands you off to SharePoint and the upload happens there --
// so the app can't set these on the way in. It sets them on the way past instead: any file
// in this pursuit's folder that's missing one of the three gets all three.
//
// Only rows with something missing are patched, so a visit costs nothing once the folder
// is tidy, and a value corrected by hand in SharePoint is never overwritten.
ForAll(
    Filter(
        'Pursuit Documents',
        "/" & gblPursuitKey & "/" in 'Folder path',
        IsBlank('Pursuit ID') || IsBlank('Account Name') || IsBlank('Pursuit Name')
    ) As D,
    Patch(
        'Pursuit Documents',
        D,
        {
            'Pursuit ID':   gblPursuitKey,
            'Account Name': gblPursuit.'Account Name',
            'Pursuit Name': gblPursuit.'Pursuit Name'
        }
    )
);

// Links. Newest change first -- Modified, not Added Date, because editing a link's type
// or URL should float it back to the top, which is what "last update" means to whoever
// asked.
//
// The Documents gallery reads the 'Pursuit Documents' library directly rather than through
// a collection: it holds files, nothing in the app writes to it, and there is no join to
// build. One less thing to refresh after a save.
ClearCollect(
    colLinks,
    Sort(Filter('pursuit-tracker-documents', 'Pursuit ID' = gblPursuitKey), Modified, SortOrder.Descending)
);

ClearCollect(
    colHistory,
    Sort(Filter('pursuit-tracker-ai-history', 'Pursuit ID' = gblPursuitKey), 'Version Number', SortOrder.Descending)
);

// Nothing in the app writes this list, so nothing guarantees exactly one current
// version. Prefer the flag, fall back to the highest version number, then to an empty
// record of the right shape so the card renders rather than erroring.
Set(gblOverview, LookUp(colHistory, 'Is Current'.Value = "Yes"));
If(IsBlank(gblOverview), Set(gblOverview, First(colHistory)));
If(IsBlank(gblOverview), Set(gblOverview, LookUp('pursuit-tracker-ai-history', ID < 0)));

Set(gblPanel, "");
Set(gblEditKey, "")
