// Paste into: Power Apps Studio -> Tree view -> scrPortfolioList -> OnVisible property
//
// The LoadPortfolio block, verbatim from src/App.OnStart.powerfx -- identical to
// scrPortfolioBoard.OnVisible except for the last line. Canvas apps have no user-defined
// behaviour functions, so it is duplicated rather than called.

// All actions, unfiltered. Filtering on Status <> "Completed" here would look tidier
// but SharePoint doesn't delegate <> on a choice column, so the server would silently
// return a truncated set. Pulling the list whole and filtering in memory is both
// correct and faster, until the list passes the 2000-row data limit.
ClearCollect(colActions, 'pursuit-tracker-actions');

// Owner display names. The owner column is an email string, not a Person column, so
// there's no .DisplayName to read -- resolve each distinct address once here rather
// than calling the connector per card. IfError keeps a departed or mistyped address
// from blanking the whole collection; you get the raw email in the UI instead.
ClearCollect(
    colPeople,
    ForAll(
        Distinct('pursuit-tracker-pursuits', 'WM Pursuit Owner Entra ID') As E,
        {
            Email: E.Value,
            Name:  IfError(Office365Users.UserProfileV2(E.Value).displayName, E.Value)
        }
    )
);

ClearCollect(
    colPortfolio,
    AddColumns(
        // Every pursuit loads. Active is filtered in the UI instead -- drpFltActive on
        // the board and the list -- so one row can be hidden without reloading, and the
        // three rows still holding "0" from when the column was a Number stay visible
        // rather than vanishing without explanation.
        'pursuit-tracker-pursuits' As P,

        OwnerName,
        Coalesce(
            LookUp(colPeople, Email = P.'WM Pursuit Owner Entra ID').Name,
            P.'WM Pursuit Owner Entra ID'
        ),

        // The next open action, as two scalar columns rather than one record column.
        // A record-valued column doesn't survive into a collection with its type intact:
        // ThisItem.NextAction.'Due Date' comes back untyped, so Text() rejects the date
        // format and Coalesce() rejects the title. Scalars just work.
        //
        // Actions with no due date are excluded -- they can't be "next due", and
        // including them would let an undated action win the sort and blank the date.
        NextActionTitle,
        First(
            Sort(
                Filter(colActions, 'Pursuit ID' = P.Title, Status.Value <> "Completed", Not(IsBlank('Due Date'))),
                'Due Date',
                SortOrder.Ascending
            )
        ).'Action Title',

        NextActionDue,
        First(
            Sort(
                Filter(colActions, 'Pursuit ID' = P.Title, Status.Value <> "Completed", Not(IsBlank('Due Date'))),
                'Due Date',
                SortOrder.Ascending
            )
        ).'Due Date',

        // Flattened choice values. Galleries bind to the raw multi-choice tables, but the
        // Excel export needs text, and computing it in two places invites drift.
        SIsText,  Concat(P.'Aligned SIs', Value, ", "),
        HypeText, Concat(P.Hyperscalers, Value, ", "),

        // Active as plain text, so the filter dropdown compares text to text rather than
        // reaching through a choice record inside a Filter predicate.
        ActiveText, P.Active.Value
    )
);

// Board columns. A literal table, in board order, matching the Workflow Stage choice set
// in the list exactly -- casing, spacing and all. Add or reorder a stage here and in the
// SharePoint column, in all three copies of this block.
//
// This used to read the column with Choices(), which is the better design and is why the
// commented version is kept below: board order would be a list setting rather than an app
// edit. It's a literal because the record Choices() returns doesn't type as text on this
// column, so Text(C.Value) raised "Expected text or number" and the whole collection
// resolved to Error -- which is a blank board with no columns and no message. A stage list
// that has changed twice in a month isn't worth a screen that can't render.
//
//  ClearCollect(colStages, ForAll(Choices('pursuit-tracker-pursuits'.'Workflow Stage') As C, { Stage: C.Value }));
ClearCollect(
    colStages,
    Table(
        { Stage: "Intake" },
        { Stage: "WM Account Team Assimilation" },
        { Stage: "Partner Introduction" },
        { Stage: "Preliminary Scoping" },
        { Stage: "Proposal/Quote" },
        { Stage: "Review/Decision" }
    )
);

// No fill-in append. Workflow Stage is FillInChoice="FALSE" in the list, so a pursuit
// cannot carry a stage that isn't in the choice set and there is nothing to append. The
// block that used to be here walked Distinct(colPortfolio, 'Workflow Stage'.Value) and was
// the source of the "Incompatible types for comparison" / "Text has some invalid arguments"
// pair that appeared identically in all three copies of this block.

// Filter options. "All" has to be prepended as its own row -- Power Fx has no way to
// concatenate two tables in a single expression, so it's a ClearCollect followed by a
// Collect rather than one formula.
//
// SI and Hyperscaler read the lookup list, so a value only appears here if it's in
// pursuit-tracker-lookups. If a value is in the SharePoint column but not the lookup
// list, it can't be filtered on.
ClearCollect(colFltSI, { Value: "All" });
Collect(colFltSI, ForAll(Filter(colLookups, LookupType = "Systems Integrator") As L, { Value: L.Value }));

ClearCollect(colFltHype, { Value: "All" });
Collect(colFltHype, ForAll(Filter(colLookups, LookupType = "Hyperscaler") As L, { Value: L.Value }));

// Active is the pursuits column's own choice set, which is fixed at three values.
ClearCollect(colFltActive, Table({ Value: "All" }, { Value: "Yes" }, { Value: "No" }, { Value: "Suspended" }));

// Close any row's ... menu left open from the previous visit.
Set(gblRowMenu, "")
