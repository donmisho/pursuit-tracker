// Paste into: Power Apps Studio -> Tree view -> scrMyActions -> OnVisible property
//
// Builds colMyActions: one row per action assigned to the signed-in user -- every status,
// not just the open ones, because the screen's View filter switches between Open, Closed
// and All. Everything the gallery needs is flattened to a scalar here, including both sort
// keys and the closed flag, so the filters and the sort do no lookups.
//
// Everything this screen needs is loaded here rather than assumed from App.OnStart.
// Collections can be stale-but-present in Studio and empty at runtime, so a screen that
// depends on another screen having been visited first renders blank when published.

Set(gblUser, User());

// The whole actions list. Filtering on Status server-side would look tidier but SharePoint
// doesn't delegate <> on a choice column, so it would silently return a truncated set.
// Pulled whole and filtered in memory, as everywhere else in this app.
ClearCollect(colActions, 'pursuit-tracker-actions');

// Pursuit identity only -- key, account, name. An action names its pursuit by text key,
// and this screen prints and filters on the account and pursuit name, so the whole pursuits
// list is reshaped once here instead of a LookUp per action against SharePoint.
ClearCollect(
    colPursuitsMin,
    ForAll(
        'pursuit-tracker-pursuits' As P,
        { Key: P.Title, Account: P.'Account Name', Name: P.'Pursuit Name' }
    )
);

// Mine.
//
// 'Action Owner Entra ID' is a text column, not a Person column, so nothing normalises what
// gets typed into it. Two mismatches show up in the real data: casing, and the domain --
// the list holds dmishory@westmonroe.com while User().Email returns
// dmishory@westmonroepartners.com. A row matches if the whole address matches, or if the
// part before the "@" does. That is deliberately loose: it assumes one person owns a given
// mailbox name across the tenant's domains, which holds here and is worth it against a
// screen that silently shows nothing.
//
// Appending "@" before Find() is what keeps an address with no "@" in it from erroring --
// Find returns blank on no match, and Left(s, blank - 1) takes the whole formula with it.
// With the "@" appended, a bare "dmishory" finds the one at the end and comes back whole.
//
// Every status loads. "Open" is a view, not a filter on the data -- see IsClosed below.
ClearCollect(
    colMyActions,
    ForAll(
        Filter(
            colActions,
            Lower('Action Owner Entra ID') = Lower(gblUser.Email) ||
            Lower(Left('Action Owner Entra ID' & "@", Find("@", 'Action Owner Entra ID' & "@") - 1)) =
                Lower(Left(gblUser.Email & "@", Find("@", gblUser.Email & "@") - 1))
        ) As A,
        With(
            { P: LookUp(colPursuitsMin, Key = A.'Pursuit ID') },
            With(
                {
                    Acct: Coalesce(P.Account, ""),
                    Full: Coalesce(P.Name, ""),
                    // Undated actions sort last rather than first, and this date is what
                    // both sort keys carry for them.
                    DueOrFar: If(IsBlank(A.'Due Date'), Date(2099, 12, 31), A.'Due Date')
                },
                With(
                    {
                        // The account prefix is stripped for display, the same way the
                        // portfolio list strips it -- "Elevance Health: Carelon Data
                        // Platform" reads as the account column plus "Carelon Data
                        // Platform", not the account twice.
                        Short: Trim(
                            If(
                                !IsBlank(Find(": ", Full)),  Mid(Full, Find(": ", Full) + 2),
                                !IsBlank(Find(" - ", Full)), Mid(Full, Find(" - ", Full) + 3),
                                Full
                            )
                        ),
                        DueText: Text(DueOrFar, "yyyy-mm-dd")
                    },
                    {
                        ActionKey:   A.Title,
                        PursuitKey:  A.'Pursuit ID',
                        ActionTitle: A.'Action Title',
                        StageText:   A.'Workflow Stage'.Value,
                        StatusText:  A.Status.Value,
                        HealthText:  A.Health.Value,
                        EffortText:  A.'Effort Size'.Value,
                        Account:     Acct,
                        Opportunity: PursuitLabel(A.'Pursuit ID', Short),
                        Due:         A.'Due Date',

                        // Closed is exactly "Completed". A blank status counts as open --
                        // an action nobody has triaged is still outstanding.
                        IsClosed:    A.Status.Value = "Completed",

                        // Same derivation the workspace uses: an action with no due date
                        // but a predecessor renders "after proposal / quote" instead.
                        DueWording:  If(
                                         !IsBlank(A.'Due Date') || IsBlank(A.'Predecessor Action ID'),
                                         "",
                                         "After " & Lower(
                                             LookUp(colActions, Title = A.'Predecessor Action ID').'Workflow Stage'.Value
                                         )
                                     ),

                        // The two sort keys, both text so a single Sort() does the whole
                        // job. Sorted-as-text dates are why the format is yyyy-mm-dd.
                        // Each ends in the ACT id, so equal keys still order the same way
                        // every time -- Power Fx does not promise a stable sort.
                        DueKey:      DueText & " " & Acct & " " & A.Title,
                        OppKey:      Acct & " " & Short & " " & A.'Pursuit ID' & " " & DueText & " " & A.Title
                    }
                )
            )
        )
    )
);

// The three views. Open is the default because it's the working list; Closed and All are
// for looking back.
ClearCollect(colFltView, Table({ Value: "Open" }, { Value: "Closed" }, { Value: "All" }));

// Account and pursuit options, built from your own actions rather than from the full
// portfolio -- an account you own nothing on would only be an empty result waiting to
// happen. "All" is prepended as its own row: Power Fx can't concatenate two tables in one
// expression, so each is a ClearCollect followed by a Collect.
//
// The pursuit list is not narrowed by the selected account. Choosing an account and then a
// pursuit that isn't in it returns nothing, which the empty state explains.
ClearCollect(colFltAcct, { Value: "All" });
Collect(
    colFltAcct,
    ForAll(Sort(Filter(Distinct(colMyActions, Account), !IsBlank(Value)), Value) As D, { Value: D.Value })
);

ClearCollect(colFltPursuit, { Value: "All" });
Collect(
    colFltPursuit,
    ForAll(Sort(Filter(Distinct(colMyActions, Opportunity), !IsBlank(Value)), Value) As D, { Value: D.Value })
);

// Sort options. In a collection rather than inline on the control, so the Items formula is
// a name and the default matches a real row.
ClearCollect(colFltSort, Table({ Value: "Due Date" }, { Value: "Opportunity" }));

// Nothing on this screen edits a pursuit, but the nav bar's Workspace button reads
// gblNewPursuit -- leaving it true would open the workspace in create mode.
Set(gblNewPursuit, false);

// Close the edit panel on arrival. gblPanel is shared with the workspace, so a panel left
// open there would otherwise be open here too, over a row you never selected.
Set(gblPanel, "");
Set(gblEditKey, "")
