// Paste into: Power Apps Studio -> Tree view -> App -> OnStart property
//
// Written against the real list schemas (docs/01-data-model.md). Joins are on the text
// key -- pursuits.Title holds PUR-nnn, and every child list points back through a text
// 'Pursuit ID' column. Text equality delegates in SharePoint, so no helper columns.

Set(gblUser, User());

// ---------------------------------------------------------------------
// Seed every global with a typed value.
//
// Power Apps infers a variable's type from the Set() calls it can see, and it can't
// infer anything from Blank() alone -- "No type found for variable 'x'. Ensure that it is
// Set to a non-Blank value somewhere in the app." The record variables are seeded with a
// LookUp that deliberately matches nothing: it returns an empty record *of the right
// shape*, which is exactly the type information the compiler is missing.
//
// Without this, each variable stays untyped until the screen that assigns it a real value
// has been pasted, so the app shows errors that depend on what you've built so far and
// clear themselves later. Typed here, the order you build in stops mattering.
// ---------------------------------------------------------------------

// Card currently picked up for a stage move. Blank when nothing is selected.
// Canvas apps have no drag-and-drop -- see docs/07-gaps-and-decisions.md.
Set(gblMoving, LookUp('pursuit-tracker-pursuits', ID < 0));

// The pursuit open on the workspace, and its current AI overview.
Set(gblPursuit, LookUp('pursuit-tracker-pursuits', ID < 0));
Set(gblOverview, LookUp('pursuit-tracker-ai-history', ID < 0));

Set(gblPursuitKey, "");       // PUR-nnn of the open pursuit
Set(gblNewPursuit, false);    // workspace is in create mode
Set(gblPanel, "");            // "" | "action" | "update" -- open slide-over
Set(gblExporting, false);     // Excel export in flight
Set(gblRowMenu, "");          // PUR-nnn whose ⋯ menu is open on the list
Set(gblEditKey, "");          // ACT/DOC/UPD id open in the workspace panel; "" = new

// The child record open in the workspace edit panel. Seeded the same way as the pursuit
// globals -- an empty record of the right shape, so every input Default has something
// typed to read before anything has been selected.
Set(gblEditAction, LookUp('pursuit-tracker-actions', ID < 0));
Set(gblEditDoc,    LookUp('pursuit-tracker-documents', ID < 0));
Set(gblEditUpdate, LookUp('pursuit-tracker-status-updates', ID < 0));


// =====================================================================
// LoadPortfolio -- shared by the board and the list screens.
//
// Canvas apps have no user-defined behaviour functions, so this block is duplicated
// verbatim into scrPortfolioBoard.OnVisible and scrPortfolioList.OnVisible, and re-run
// after any patch that changes a stage. Change it here, then paste it into both.
// =====================================================================

// All actions, unfiltered. Filtering on Status <> "Completed" here would look tidier
// but SharePoint doesn't delegate <> on a choice column, so the server would silently
// return a truncated set. Pulling the list whole and filtering in memory is both
// correct and faster, until the list passes the 2000-row data limit.
ClearCollect(colActions, 'pursuit-tracker-actions');

// Owner display names. The owner column is an email string, not a Person column, so
// there's no .DisplayName to read -- resolve each distinct address once here rather
// than calling the connector per card. IfError keeps a departed or mistyped address
// from blanking the whole collection; you get the raw email in the UI instead.
ClearCollect(
    colPeople,
    ForAll(
        Distinct('pursuit-tracker-pursuits', 'WM Pursuit Owner Entra ID') As E,
        {
            Email: E.Value,
            Name:  IfError(Office365Users.UserProfileV2(E.Value).displayName, E.Value)
        }
    )
);

ClearCollect(
    colPortfolio,
    AddColumns(
        // Every pursuit loads. Active is filtered in the UI instead -- drpFltActive on
        // the board and the list -- so one row can be hidden without reloading, and the
        // three rows still holding "0" from when the column was a Number stay visible
        // rather than vanishing without explanation.
        'pursuit-tracker-pursuits' As P,

        OwnerName,
        Coalesce(
            LookUp(colPeople, Email = P.'WM Pursuit Owner Entra ID').Name,
            P.'WM Pursuit Owner Entra ID'
        ),

        // The next open action, as two scalar columns rather than one record column.
        // A record-valued column doesn't survive into a collection with its type intact:
        // ThisItem.NextAction.'Due Date' comes back untyped, so Text() rejects the date
        // format and Coalesce() rejects the title. Scalars just work.
        //
        // Actions with no due date are excluded -- they can't be "next due", and
        // including them would let an undated action win the sort and blank the date.
        NextActionTitle,
        First(
            Sort(
                Filter(colActions, 'Pursuit ID' = P.Title, Status.Value <> "Completed", Not(IsBlank('Due Date'))),
                'Due Date',
                SortOrder.Ascending
            )
        ).'Action Title',

        NextActionDue,
        First(
            Sort(
                Filter(colActions, 'Pursuit ID' = P.Title, Status.Value <> "Completed", Not(IsBlank('Due Date'))),
                'Due Date',
                SortOrder.Ascending
            )
        ).'Due Date',

        // Flattened choice values. Galleries bind to the raw multi-choice tables, but the
        // Excel export needs text, and computing it in two places invites drift.
        SIsText,  Concat(P.'Aligned SIs', Value, ", "),
        HypeText, Concat(P.Hyperscalers, Value, ", "),

        // Active as plain text, so the filter dropdown compares text to text rather than
        // reaching through a choice record inside a Filter predicate.
        ActiveText, P.Active.Value
    )
);

// Board columns. A literal table, in board order, matching the Workflow Stage choice set
// in the list exactly -- casing, spacing and all. Add or reorder a stage here and in the
// SharePoint column, in all three copies of this block.
//
// This used to read the column with Choices(), which is the better design and is why the
// commented version is kept below: board order would be a list setting rather than an app
// edit. It's a literal because the record Choices() returns doesn't type as text on this
// column, so Text(C.Value) raised "Expected text or number" and the whole collection
// resolved to Error -- which is a blank board with no columns and no message. A stage list
// that has changed twice in a month isn't worth a screen that can't render.
//
//  ClearCollect(colStages, ForAll(Choices('pursuit-tracker-pursuits'.'Workflow Stage') As C, { Stage: C.Value }));
ClearCollect(
    colStages,
    Table(
        { Stage: "Intake" },
        { Stage: "WM Account Team Assimilation" },
        { Stage: "Partner Introduction" },
        { Stage: "Preliminary Scoping" },
        { Stage: "Proposal/Quote" },
        { Stage: "Review/Decision" }
    )
);

// No fill-in append. Workflow Stage is FillInChoice="FALSE" in the list, so a pursuit
// cannot carry a stage that isn't in the choice set and there is nothing to append. The
// block that used to be here walked Distinct(colPortfolio, 'Workflow Stage'.Value) and was
// the source of the "Incompatible types for comparison" / "Text has some invalid arguments"
// pair that appeared identically in all three copies of this block.


// =====================================================================
// The shared vocabulary behind every edit dropdown. One list, one row per allowed value,
// keyed by Title (the "Lookup Type" column) -- so adding a workflow stage is a row in a
// list rather than a change to five column definitions.
//
// Loaded once into a collection rather than read per dropdown. Neither half of this
// delegates to SharePoint -- Active is a Choice column and 'Sort Order' is sorting a
// filtered set -- and at 28 rows the whole list costs one call, so doing it in memory is
// both correct and cheaper than twelve delegation warnings.
//
// Projected with ForAll and a record literal rather than ShowColumns. ShowColumns
// rejects a SharePoint source whose column set it can't pin down at author time -- it
// throws "ShowColumns has some invalid arguments" -- and it does the same to the choice
// tables the combo boxes read. ForAll over an explicit record literal is the pattern the
// rest of this file already uses and it types cleanly in both places.
//
// The shape is what matters: a table whose only column is Value is exactly what Choices()
// returns, which is what a Classic/DropDown displays and what .Selected.Value reads. The
// lookup type comes across as LookupType rather than Title -- 'Title' is doing double duty
// as a SharePoint column name everywhere else in this app, and Type is a Power Fx keyword.
//
// LAST, and wrapped. OnStart is one statement chain: a formula that throws stops every
// statement after it, silently, and the app opens on an empty board with no error. Only
// the edit dropdowns need this collection, so it goes behind the portfolio load where a
// bad list name or a renamed column costs you a notification instead of the whole app.
// =====================================================================
IfError(
    ClearCollect(
        colLookups,
        // No Active filter. The column is a Choice with an empty choice set, and a Choice
        // column with no defined choices doesn't reach the Power Apps schema -- referencing
        // it fails at author time with "Name isn't valid. 'Active' isn't recognized", which
        // takes the whole ClearCollect with it. Every row is Active today, so nothing is
        // lost until a value needs retiring.
        //
        // To turn retirement back on, make Active a real column in SharePoint -- either a
        // Yes/No column, or a Choice with Yes and No actually defined -- refresh the data
        // source in the Data pane, and wrap the source below in one of:
        //     Filter('pursuit-tracker-lookups', Active)                  // Yes/No
        //     Filter('pursuit-tracker-lookups', Active.Value = "Yes")    // Choice
        ForAll(
            Sort('pursuit-tracker-lookups', 'Sort Order', SortOrder.Ascending) As L,
            { LookupType: L.Title, Value: L.Value }
        )
    ),
    Notify("Lookup list didn't load -- edit dropdowns will be empty. " & FirstError.Message, NotificationType.Warning)
);
