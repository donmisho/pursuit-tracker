// Paste into: Power Apps Studio -> Tree view -> App -> OnStart property
//
// Written against the real list schemas (docs/01-data-model.md). Joins are on the text
// key -- pursuits.Title holds PUR-nnn, and every child list points back through a text
// 'Pursuit ID' column. Text equality delegates in SharePoint, so no helper columns.

Set(gblUser, User());

// ---------------------------------------------------------------------
// Seed every global with a typed value.
//
// Power Apps infers a variable's type from the Set() calls it can see, and it can't
// infer anything from Blank() alone -- "No type found for variable 'x'. Ensure that it is
// Set to a non-Blank value somewhere in the app." The record variables are seeded with a
// LookUp that deliberately matches nothing: it returns an empty record *of the right
// shape*, which is exactly the type information the compiler is missing.
//
// Without this, each variable stays untyped until the screen that assigns it a real value
// has been pasted, so the app shows errors that depend on what you've built so far and
// clear themselves later. Typed here, the order you build in stops mattering.
// ---------------------------------------------------------------------

// Card currently picked up for a stage move. Blank when nothing is selected.
// Canvas apps have no drag-and-drop -- see docs/07-gaps-and-decisions.md.
Set(gblMoving, LookUp('pursuit-tracker-pursuits', ID < 0));

// The pursuit open on the workspace, and its current AI overview.
Set(gblPursuit, LookUp('pursuit-tracker-pursuits', ID < 0));
Set(gblOverview, LookUp('pursuit-tracker-ai-history', ID < 0));

Set(gblPursuitKey, "");       // PUR-nnn of the open pursuit
Set(gblNewPursuit, false);    // workspace is in create mode
Set(gblPanel, "");            // "" | "action" | "update" -- open slide-over
Set(gblExporting, false);     // Excel export in flight
Set(gblRowMenu, "");          // PUR-nnn whose ⋯ menu is open on the list
Set(gblEditKey, "");          // ACT/DOC/UPD id open in the workspace panel; "" = new

// The child record open in the workspace edit panel. Seeded the same way as the pursuit
// globals -- an empty record of the right shape, so every input Default has something
// typed to read before anything has been selected.
Set(gblEditAction, LookUp('pursuit-tracker-actions', ID < 0));
Set(gblEditDoc,    LookUp('pursuit-tracker-documents', ID < 0));
Set(gblEditUpdate, LookUp('pursuit-tracker-status-updates', ID < 0));


// =====================================================================
// LoadPortfolio -- shared by the board and the list screens.
//
// Canvas apps have no user-defined behaviour functions, so this block is duplicated
// verbatim into scrPortfolioBoard.OnVisible and scrPortfolioList.OnVisible, and re-run
// after any patch that changes a stage. Change it here, then paste it into both.
// =====================================================================

// All actions, unfiltered. Filtering on Status <> "Completed" here would look tidier
// but SharePoint doesn't delegate <> on a choice column, so the server would silently
// return a truncated set. Pulling the list whole and filtering in memory is both
// correct and faster, until the list passes the 2000-row data limit.
ClearCollect(colActions, 'pursuit-tracker-actions');

// Owner display names. The owner column is an email string, not a Person column, so
// there's no .DisplayName to read -- resolve each distinct address once here rather
// than calling the connector per card. IfError keeps a departed or mistyped address
// from blanking the whole collection; you get the raw email in the UI instead.
ClearCollect(
    colPeople,
    ForAll(
        Distinct('pursuit-tracker-pursuits', 'WM Pursuit Owner Entra ID') As E,
        {
            Email: E.Value,
            Name:  IfError(Office365Users.UserProfileV2(E.Value).displayName, E.Value)
        }
    )
);

ClearCollect(
    colPortfolio,
    AddColumns(
        // No Active filter yet -- every row was 0 when the schema was read, so filtering
        // would empty the board. Switch one of these in once the column means something:
        //     Filter('pursuit-tracker-pursuits', Active = 1) As P     // still a Number
        //     Filter('pursuit-tracker-pursuits', Active) As P         // converted to Yes/No
        'pursuit-tracker-pursuits' As P,

        OwnerName,
        Coalesce(
            LookUp(colPeople, Email = P.'WM Pursuit Owner Entra ID').Name,
            P.'WM Pursuit Owner Entra ID'
        ),

        // The next open action, as two scalar columns rather than one record column.
        // A record-valued column doesn't survive into a collection with its type intact:
        // ThisItem.NextAction.'Due Date' comes back untyped, so Text() rejects the date
        // format and Coalesce() rejects the title. Scalars just work.
        //
        // Actions with no due date are excluded -- they can't be "next due", and
        // including them would let an undated action win the sort and blank the date.
        NextActionTitle,
        First(
            Sort(
                Filter(colActions, 'Pursuit ID' = P.Title, Status.Value <> "Completed", Not(IsBlank('Due Date'))),
                'Due Date',
                SortOrder.Ascending
            )
        ).'Action Title',

        NextActionDue,
        First(
            Sort(
                Filter(colActions, 'Pursuit ID' = P.Title, Status.Value <> "Completed", Not(IsBlank('Due Date'))),
                'Due Date',
                SortOrder.Ascending
            )
        ).'Due Date',

        // Flattened choice values. Galleries bind to the raw multi-choice tables, but the
        // Excel export needs text, and computing it in two places invites drift.
        SIsText,  Concat(P.'Aligned SIs', Value, ", "),
        HypeText, Concat(P.Hyperscalers, Value, ", ")
    )
);

// Board columns, read from the Workflow Stage choice list. Board order is whatever order
// the choices are in on the SharePoint column, so adding or reordering a stage is a list
// edit, not an app edit.
ClearCollect(
    colStages,
    ForAll(
        Choices('pursuit-tracker-pursuits'.'Workflow Stage') As C,
        { Stage: C.Value }
    )
);

// Fallback for an empty choice list. These columns have fill-in enabled, so before the
// choice values were defined Choices() returned nothing and the board rendered zero
// columns -- a blank screen with no error to explain it. Keep this until you're sure the
// choice list can't be emptied again.
If(
    CountRows(colStages) = 0,
    ClearCollect(
        colStages,
        Table(
            { Stage: "Unassigned" },
            { Stage: "WM Account Team Assimilation" },
            { Stage: "Partner Introduction" },
            { Stage: "Preliminary Scoping" },
            { Stage: "Proposal/Quote" }
        )
    )
);

// Fill-in choices mean a pursuit can carry a stage that was typed rather than picked, and
// so isn't in the choice list. Append those at the end rather than dropping the pursuits
// that hold them -- an unexpected trailing column is a visible prompt to fix the data.
ForAll(
    Distinct(colPortfolio, 'Workflow Stage'.Value) As S,
    If(
        IsBlank(S.Value) || !IsBlank(LookUp(colStages, Stage = S.Value)),
        false,
        Collect(colStages, { Stage: S.Value })
    )
);
