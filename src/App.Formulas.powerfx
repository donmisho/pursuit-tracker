// Paste into: Power Apps Studio -> Tree view -> App -> Formulas property
//
// These are Named Formulas, not variables. They are evaluated lazily and recomputed
// automatically, they cost nothing at startup, and they can't be accidentally
// overwritten by a stray Set() somewhere in the app. Every colour in the three screens
// resolves through here -- change a token, the whole app follows.
//
// Named formulas can't reference controls and can't have side effects. Anything that
// loads data lives in App.OnStart / screen OnVisible instead.

// ---------------------------------------------------------------- surfaces
ClrPage        = ColorValue("#10141F");   // app background
ClrNav         = ColorValue("#1A2030");   // top nav bar
ClrColumn      = ColorValue("#171D2B");   // kanban column background
ClrCard        = ColorValue("#1E2534");   // cards, panels
ClrCardHover   = ColorValue("#252D3E");
ClrBorder      = ColorValue("#2C3547");
ClrDivider     = ColorValue("#232B3B");

// ---------------------------------------------------------------- text
ClrText        = ColorValue("#F2F5FA");   // primary
ClrTextHex     = "#F2F5FA";               // the same colour as a string, for StatusHtml's
                                          // inline CSS. Keep the two in step by hand --
                                          // Power Fx has no way to read a Color back out.
ClrTextMuted   = ColorValue("#98A3B8");   // subtitles, column headers
ClrTextFaint   = ColorValue("#6F7B90");   // provenance lines, timestamps

// ---------------------------------------------------------------- accents
ClrAccent      = ColorValue("#6B7DF2");   // New pursuit / Download Excel / Refresh
ClrAccentHover = ColorValue("#5A6CE0");
ClrAccentText  = ColorValue("#FFFFFF");
ClrDate        = ColorValue("#EFA98E");   // "August 7" on cards -- warm, deliberate
ClrLink        = ColorValue("#8FA2FF");

// ---------------------------------------------------------------- chips & pills
ClrChip        = ColorValue("#2A3243");
ClrChipText    = ColorValue("#CBD4E4");
ClrAvatar      = ColorValue("#3D4A66");
ClrAvatarText  = ColorValue("#DCE3F0");
ClrDocWord     = ColorValue("#4DA6FF");   // .doc  .docx
ClrDocPpt      = ColorValue("#E08A3C");   // .ppt  .pptx
ClrDocXl       = ColorValue("#4FA85C");   // .xls  .xlsx  .csv
ClrDocMail     = ColorValue("#D8B84A");   // .msg  .eml
ClrDocPdf      = ColorValue("#D9534F");   // .pdf
ClrDocOther    = ColorValue("#E6E9F0");   // anything else, and no extension at all

ClrRiskFill    = ColorValue("#7E3B3B");
ClrRiskText    = ColorValue("#F6D2D2");
ClrOkFill      = ColorValue("#2F4A3C");
ClrOkText      = ColorValue("#BFE3CE");

// ---------------------------------------------------------------- type scale
FontUI         = Font.'Segoe UI';
SizePageTitle  = 26;
SizeCardTitle  = 15;
SizeBody       = 12;
SizeMeta       = 10;
SizeChip       = 9;

// ---------------------------------------------------------------- metrics
GapPage        = 24;   // page gutter
GapCard        = 16;   // inside a card
RadiusCard     = 8;
RadiusChip     = 10;
BoardColumns   = 6;    // stage columns visible without scrolling; the board divides
                       // the canvas by this rather than using a fixed column width

// ---------------------------------------------------------------- site
// The SharePoint site, for the links that leave the app -- the Pursuit Documents
// library in particular. One place to change if the site ever moves.
SiteUrl = "https://westmonroepartners1.sharepoint.com/sites/PursuitTracking";

// "PUR-014 - Dynamics F&O". The pursuit's own identity line, used as the subtitle on the
// workspace and the documents screen so both name the same thing the same way.
PursuitLabel(id: Text, name: Text): Text =
    If(IsBlank(id), name, id & " - " & name);

// ---------------------------------------------------------------- helpers
// Stage colour, used for the thin accent on a board column header. Stage names are the
// values actually present in the list, casing included. Anything unmatched falls
// through to the muted colour rather than rendering black-on-black.
StageAccent(stage: Text): Color =
    Switch(
        stage,
        "Intake",                       ColorValue("#5A6474"),
        "WM Account Team Assimilation", ColorValue("#6B7DF2"),
        "Partner Introduction",         ColorValue("#5AB0C9"),
        "Preliminary Scoping",          ColorValue("#8E7BD8"),
        "Proposal/Quote",               ColorValue("#D8A05A"),
        "Review/Decision",               ColorValue("#C96A6A"),
        ClrTextMuted
    );

// "August 7" when there's a due date; otherwise the dependency wording the app derives
// from Predecessor Action ID ("after proposal / quote"), which is what the workspace
// mockup shows in the Legal review row. Blank when there's neither.
DueLabel(due: DateTime, wording: Text): Text =
    If(
        !IsBlank(due), Text(due, "mmmm d"),
        !IsBlank(wording), wording,
        ""
    );

// The file-type chip's colours live here; the letters and the border switch inline on
// scrPursuitDocsAI. That was a pair of user-defined functions and the letters came back
// empty while the border still coloured -- the same switch in two properties is more
// duplication than I'd like, but it depends on nothing but a token.

// "Don Mishory" -> "DM". Owner columns hold email addresses, so when Office 365 Users
// can't resolve one the raw address arrives here and yields a single letter -- ugly but
// legible, and a visible cue that the address is wrong.
Initials(name: Text): Text =
    Concat(FirstN(Split(name, " "), 2), Left(Value, 1));

// Trim to a character budget with an ellipsis. Power Apps labels have no text-overflow
// setting: a Label whose text needs more lines than its Height allows does not clip, it
// keeps rendering, and because the default VerticalAlign is Middle the overflow spills
// out of BOTH ends and lands on top of the controls above and below. Top-aligning stops
// it spilling upward; this stops it spilling downward.
Clip(s: Text, n: Number): Text =
    If(Len(s) > n, Left(s, n - 1) & "…", s);

// Document URLs are stored as plain text and some have no scheme
// ("westmonroepartners1-my.sharepoint.com/..."), which Launch() treats as a relative
// path and opens as a broken address.
SafeUrl(url: Text): Text =
    If(StartsWith(Lower(url), "http"), url, "https://" & url);

// ---------------------------------------------------------------- pasted rich text
// Delete every occurrence of one CSS declaration from a fragment of HTML.
//
// Text pasted into the rich text editor from Word, Outlook or Teams brings its own inline
// styling with it -- headings arrive as color:#4472C4 on a white page, which is close to
// invisible on the dark card that later displays them. An inline colour beats anything a
// wrapping element sets, so the only fix is to take the declaration out of the string.
//
// Split on the property name, then from each following piece drop everything up to the
// first ";" or quote or ">" -- that span is the value, and the delimiter itself is kept so
// the rest of the style attribute survives intact. Note that splitting on "color:" also
// catches "background-color:", which is wanted: a pasted white background is exactly as
// unreadable as light blue text. The leftover "background-;" is invalid CSS and ignored.
//
// The one false positive is prose that literally contains "color:" or "font-size:", where
// the next few words are eaten. Worth it.
DropDecl(html: Text, decl: Text): Text =
    With(
        { parts: Split(html, decl) },
        First(parts).Value &
        Concat(
            ForAll(
                Sequence(CountRows(parts) - 1, 2, 1) As I,
                {
                    Tail: With(
                        { s: Index(parts, I.Value).Value },
                        Mid(
                            s,
                            Min(
                                If(Find(";",  s) > 0, Find(";",  s), Len(s) + 1),
                                If(Find("""", s) > 0, Find("""", s), Len(s) + 1),
                                If(Find("'",  s) > 0, Find("'",  s), Len(s) + 1),
                                If(Find(">",  s) > 0, Find(">",  s), Len(s) + 1)
                            )
                        )
                    )
                }
            ),
            Tail
        )
    );

// Take stored HTML and render it the way the dark cards need: body text white at the app's
// body size, headings bold and two points larger. Strip the pasted colours and sizes first,
// then set the size on the wrapper so everything that isn't a heading inherits one size.
//
// The heading style is injected as the FIRST attribute of each tag deliberately. HTML keeps
// the first of any duplicated attribute and ignores the rest, so "<h2 style=ours style=theirs>"
// resolves to ours -- no need to find and rewrite whatever the paste left behind.
//
// This runs at display time, so it fixes updates that were saved before it existed and
// leaves the SharePoint column holding exactly what the editor produced.
StatusHtml(html: Text): Text =
    If(
        IsBlank(html),
        "",
        With(
            {
                clean: DropDecl(DropDecl(html, "color:"), "font-size:"),
                head:  "font-size:" & Text(SizeBody + 2) & "pt;font-weight:700;color:" &
                       ClrTextHex & ";margin:14px 0 4px 0;"
            },
            "<div style=""color:" & ClrTextHex &
            ";font-family:'Segoe UI',Segoe,sans-serif;font-size:" & Text(SizeBody) &
            "pt;line-height:1.45;"">" &
            Substitute(
                Substitute(
                    Substitute(
                        Substitute(
                            Substitute(
                                Substitute(clean, "<h1", "<h1 style=""" & head & """"),
                                "<h2", "<h2 style=""" & head & """"),
                            "<h3", "<h3 style=""" & head & """"),
                        "<h4", "<h4 style=""" & head & """"),
                    "<h5", "<h5 style=""" & head & """"),
                "<h6", "<h6 style=""" & head & """") &
            "</div>"
        )
    );

// "Today" / "Yesterday" / "August 1" for the status update feed.
RelativeDay(when: DateTime): Text =
    Switch(
        DateDiff(when, Now(), TimeUnit.Days),
        0, "Today",
        1, "Yesterday",
        Text(when, "mmmm d")
    );
